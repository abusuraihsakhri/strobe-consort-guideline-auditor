{
  "openapi": "3.1.0",
  "info": {
    "title": "STROBE / CONSORT Reporting Checklist API",
    "version": "3.1.0",
    "description": "Manual reporting review summaries; legacy numerical endpoints are not reporting-compliance validators."
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Static reporting checklist interface",
        "responses": {
          "200": {
            "description": "HTML application"
          }
        }
      }
    },
    "/checklists.json": {
      "get": {
        "summary": "Versioned condensed checklist topics",
        "responses": {
          "200": {
            "description": "JSON catalogue"
          }
        }
      }
    },
    "/api/checklists": {
      "get": {
        "summary": "Checklist catalogue",
        "responses": {
          "200": {
            "description": "JSON catalogue"
          }
        }
      }
    },
    "/api/checklist/summary": {
      "post": {
        "summary": "Validate and count reviewer judgments (not methodological quality)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "format",
                  "guideline",
                  "version",
                  "manuscript",
                  "items"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Descriptive counts and warnings"
          },
          "422": {
            "description": "Invalid review"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Legacy server health",
        "responses": {
          "200": {
            "description": "Service metadata"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Legacy counters",
        "responses": {
          "200": {
            "description": "Counters"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Legacy generic threshold demonstration (not guideline review)",
        "responses": {
          "200": {
            "description": "Legacy dossier"
          },
          "422": {
            "description": "Invalid or blocked input"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Legacy placeholder response; not automated review",
        "responses": {
          "200": {
            "description": "Response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Legacy audit log (disabled by default)",
        "responses": {
          "200": {
            "description": "Audit chain"
          },
          "403": {
            "description": "Disabled"
          }
        }
      }
    }
  }
}
